# Copy this file to .env and fill in real values locally.
# Never commit the .env file or real credentials.

# --- Required: SAP BusinessObjects BI Platform connection ---
BO_BASE_URL=
BO_AUTH_TYPE=secEnterprise
BO_USERNAME=
BO_PASSWORD=

# --- Optional: OAuth / client-credential style auth ---
BO_CLIENT_ID=
BO_CLIENT_SECRET=

# --- Optional: SAP HANA read-only lineage enrichment ---
HANA_ADDRESS=
HANA_PORT=
HANA_USER=
HANA_PASSWORD=

# --- Extraction settings ---
BO_LOG_LEVEL=INFO
